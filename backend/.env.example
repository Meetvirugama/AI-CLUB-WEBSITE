# ─── PostgreSQL (FastAPI + asyncpg) ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Your OAuth2 Client ID from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Super Admin Email — the Google account that can create/edit/delete events
# Must exactly match the email returned by Google OAuth for the admin account.
SUPER_ADMIN_EMAIL=admin@yourdomain.com

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET

# Optional: token expiry in minutes (default: 10080 = 7 days)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── LLM Provider Pool — Groq (primary, lower latency / cost) ────────────────
# Get keys at: https://console.groq.com/keys
# Model used: llama-3.3-70b-versatile
# The chatbot rotates across healthy keys and skips rate-limited ones (60 s cooldown).
GROQ_API_KEY_1=your_groq_api_key_1_here
GROQ_API_KEY_2=your_groq_api_key_2_here
GROQ_API_KEY_3=your_groq_api_key_3_here
GROQ_API_KEY_4=your_groq_api_key_4_here
GROQ_API_KEY_5=your_groq_api_key_5_here
GROQ_API_KEY_6=your_groq_api_key_6_here
GROQ_API_KEY_7=your_groq_api_key_7_here

# ─── LLM Provider Pool — Gemini (fallback) ───────────────────────────────────
# Get keys at: https://aistudio.google.com/app/apikey
# Model used: gemini-2.5-flash
# Used only when all Groq keys are rate-limited or unavailable.
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY_3=your_gemini_api_key_3_here
GEMINI_API_KEY_4=your_gemini_api_key_4_here
GEMINI_API_KEY_5=your_gemini_api_key_5_here

# ─── Legacy Gemini key (backward compat) ─────────────────────────────────────
# Only used if GEMINI_API_KEY_1 … _5 are all absent.
GOOGLE_API_KEY=your_gemini_api_key_here

# ─── Allowed browser origins ──────────────────────────────────────────────────
# Comma-separated frontend origins, no trailing slash. Backs BOTH the CORS
# allowlist and the CSRF Origin check, so it must list every origin the site is
# served from. REQUIRED in production — the app refuses to start without it.
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# ─── Proxy awareness ──────────────────────────────────────────────────────────
# Set to "true" when deployed behind a reverse proxy (Render, Vercel,
# Cloudflare, nginx) so rate limiting reads the real client IP from
# X-Forwarded-For. Leave unset if the app is directly reachable — otherwise a
# client can spoof its own address and bypass the rate limiter.
TRUST_PROXY=false

# ─── Environment ──────────────────────────────────────────────────────────────
# Set to "production" on your deployment platform.
# In production: Secure + SameSite=None cookies, HSTS, docs disabled, and a
# strong JWT_SECRET_KEY and ALLOWED_ORIGINS are enforced at startup.
ENVIRONMENT=development

# ─── Backend Port ─────────────────────────────────────────────────────────────
PORT=8000

